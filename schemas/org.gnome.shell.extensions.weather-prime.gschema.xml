<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.weather-prime"
          path="/org/gnome/shell/extensions/weather-prime/">
    <key name="api-provider" type="s"><default>'open-meteo'</default><summary>Weather API provider</summary></key>
    <key name="weatherapi-key" type="s"><default>''</default><summary>WeatherAPI.com API key</summary></key>
    <key name="weatherai-key" type="s"><default>''</default><summary>WeatherAI.io API key</summary></key>
    <key name="tomorrow-api-key" type="s"><default>''</default><summary>Tomorrow.io API key (unused)</summary></key>
    <key name="ambee-api-key" type="s"><default>''</default><summary>Ambee API key (unused)</summary></key>
    <key name="airnow-api-key" type="s"><default>''</default><summary>AirNow API key</summary></key>
    <key name="openweather-api-key" type="s"><default>''</default><summary>OpenWeatherMap API key</summary></key>
    <key name="aq-source" type="s"><default>'auto'</default><summary>Air quality source: auto, airnow, openweather, or open-meteo</summary></key>
    <key name="location-auto" type="b"><default>true</default><summary>Use automatic location via GeoClue</summary></key>
    <key name="location-latitude" type="d"><default>0.0</default><summary>Manual location latitude</summary></key>
    <key name="location-longitude" type="d"><default>0.0</default><summary>Manual location longitude</summary></key>
    <key name="location-name" type="s"><default>''</default><summary>Display name for the manual location</summary></key>
    <key name="temperature-unit" type="s"><default>'fahrenheit'</default><summary>Temperature unit</summary></key>
    <key name="wind-unit" type="s"><default>'mph'</default><summary>Wind speed unit: mph, kmh, or ms</summary></key>
    <key name="pressure-unit" type="s"><default>'hpa'</default><summary>Pressure unit: hpa, inhg, or mmhg</summary></key>
    <key name="update-interval" type="i"><default>30</default><summary>Update interval (legacy)</summary></key>
    <key name="fetch-interval" type="i"><default>1440</default><summary>Weather fetch interval in minutes</summary></key>
    <key name="pollen-fetch-interval" type="i"><default>1440</default><summary>Pollen fetch interval (legacy)</summary></key>
    <key name="color-scheme" type="s">
      <default>'auto'</default>
      <summary>Panel color scheme: auto, dark, or light</summary>
    </key>

    <key name="aq-fetch-interval" type="i"><default>60</default><summary>Air quality fetch interval in minutes</summary></key>
    <key name="panel-position" type="s"><default>'right'</default><summary>Panel position: left, center, or right</summary></key>
    <key name="panel-size" type="s"><default>'original'</default><summary>Drop-down panel size: original or large (1.5x)</summary></key>
  </schema>
</schemalist>
